# Base de datos (Railway o Supabase)
DATABASE_URL="postgresql://user:password@host:5432/crm_inmobiliario"

# NextAuth
NEXTAUTH_SECRET="genera-un-secret-seguro-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp (número sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER="56912345678"

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# URL pública del sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed de producción (solo para prisma/seed-prod.ts)
SEED_ADMIN_EMAIL="admin@tudominio.cl"
SEED_ADMIN_PASSWORD="cambia-esta-contraseña"
