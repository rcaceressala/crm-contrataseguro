generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["seguros"]
}

enum Role {
  ADMIN
  ASESOR

  @@schema("seguros")
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  COTIZADO
  CONVERTIDO
  PERDIDO

  @@schema("seguros")
}

enum LeadSource {
  INSTAGRAM
  FACEBOOK_ADS
  GOOGLE_ADS
  TIKTOK
  WHATSAPP
  ORGANICO
  REFERIDO
  MANUAL

  @@schema("seguros")
}

enum InsuranceCategory {
  COMPLEMENTARIO
  DENTAL
  CATASTROFICO
  MASCOTAS
  HOGAR
  AUTOMOTRIZ
  VIDA

  @@schema("seguros")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(ASESOR)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  leads        Lead[]     @relation("AssignedLeads")
  notes        LeadNote[]
  followUps    FollowUp[]
  sales        Sale[]

  @@schema("seguros")
}

model Lead {
  id             String            @id @default(cuid())
  name           String
  phone          String
  email          String?
  message        String?
  status         LeadStatus        @default(NUEVO)
  source         LeadSource        @default(MANUAL)
  category       InsuranceCategory
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  fbclid         String?
  gclid          String?
  landingPage    String?
  referrer       String?
  device         String?
  ipAddress      String?
  assignedTo     User?      @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  assignedUserId String?
  campaign       Campaign?  @relation(fields: [campaignId], references: [id])
  campaignId     String?
  notes          LeadNote[]
  followUps      FollowUp[]
  sale           Sale?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@schema("seguros")
}

model LeadNote {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  note      String
  createdAt DateTime @default(now())

  @@schema("seguros")
}

model FollowUp {
  id           String   @id @default(cuid())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       String
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  followUpDate DateTime
  description  String
  done         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("seguros")
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  platform    String
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  active      Boolean   @default(true)
  leads       Lead[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@schema("seguros")
}

model Sale {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  producto  String
  comision  Float
  saleDate  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  @@schema("seguros")
}

model TrackingEvent {
  id          String   @id @default(cuid())
  type        String
  page        String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  fbclid      String?
  gclid       String?
  device      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@schema("seguros")
}